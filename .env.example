# Copy this file, name the copy ".env", and fill in your Supabase details.
# Find them in Supabase: Project Settings > API (URL) and API Keys (secret key).
# Leave them empty to keep saving data in local files instead.

SUPABASE_URL=https://your-project-id.supabase.co

# The SECRET key ("service_role" or "sb_secret_..."). Keep it private:
# never put it in the website's HTML or JavaScript, never share it or send it in chat.
SUPABASE_SERVICE_ROLE_KEY=
